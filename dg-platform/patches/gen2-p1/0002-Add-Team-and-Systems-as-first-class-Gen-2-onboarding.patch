+/**
+ * Onboarding Systems step — inventory of tools the organisation uses.
+ * SoT is organisation.settings.systems plus connector blobs for known ids.
+ * WordPress may appear as a customer-site connector, never as platform SoT.
+ */
+
+export type Gen2SystemOption = {
+  id: string;
+  label: string;
+  /** Connector engine id when this system maps to a Gen 2 connector. */
+  connectorId: string | null;
+  group: "website" | "communications" | "commerce" | "ops" | "other";
+};
+
+export const GEN2_SYSTEM_OPTIONS: readonly Gen2SystemOption[] = [
+  { id: "google-gbp", label: "Google Business Profile", connectorId: "google-gbp", group: "ops" },
+  { id: "google-gmail", label: "Gmail / Google Workspace", connectorId: "google-gmail", group: "communications" },
+  { id: "microsoft-365", label: "Microsoft 365 / Outlook", connectorId: "microsoft-365", group: "communications" },
+  { id: "stripe", label: "Stripe", connectorId: "stripe", group: "commerce" },
+  { id: "wordpress-site", label: "WordPress website (customer site)", connectorId: "wordpress", group: "website" },
+  { id: "shopify", label: "Shopify", connectorId: null, group: "website" },
+  { id: "xero", label: "Xero", connectorId: null, group: "commerce" },
+  { id: "myob", label: "MYOB", connectorId: null, group: "commerce" },
+  { id: "quickbooks", label: "QuickBooks", connectorId: null, group: "commerce" },
+  { id: "hubspot", label: "HubSpot", connectorId: null, group: "ops" },
+  { id: "salesforce", label: "Salesforce", connectorId: null, group: "ops" },
+  { id: "calendly", label: "Calendly / booking tool", connectorId: null, group: "ops" },
+  { id: "mailchimp", label: "Mailchimp / Klaviyo", connectorId: null, group: "communications" },
+  { id: "ga4", label: "Google Analytics / Search Console", connectorId: null, group: "ops" },
+  { id: "none", label: "None of these yet", connectorId: null, group: "other" },
+] as const;
+
+export const GEN2_SYSTEM_OPTION_IDS = GEN2_SYSTEM_OPTIONS.map((o) => o.id);
+
+export type OrgOnboardingSystems = {
+  selectedIds: string[];
+  notes?: string;
+  updatedAt: string;
+};
+
+export function normalizeOnboardingSystemIds(raw: unknown): string[] {
+  if (!Array.isArray(raw)) return [];
+  const allowed = new Set(GEN2_SYSTEM_OPTION_IDS);
+  const out: string[] = [];
+  for (const value of raw) {
+    if (typeof value !== "string") continue;
+    const id = value.trim();
+    if (!allowed.has(id) || out.includes(id)) continue;
+    out.push(id);
+  }
+  return out;
+}
+
+export function parseOrgOnboardingSystems(raw: unknown): OrgOnboardingSystems | null {
+  if (!raw || typeof raw !== "object") return null;
+  const row = raw as { selectedIds?: unknown; notes?: unknown; updatedAt?: unknown };
+  const selectedIds = normalizeOnboardingSystemIds(row.selectedIds);
+  return {
+    selectedIds,
+    notes: typeof row.notes === "string" ? row.notes : undefined,
+    updatedAt: typeof row.updatedAt === "string" ? row.updatedAt : new Date(0).toISOString(),
+  };
+}
+
+export async function getOrgOnboardingSystems(
+  organisationId: string,
+): Promise<OrgOnboardingSystems | null> {
+  if (!process.env.DATABASE_URL) return null;
+  const { prisma } = await import("@dg/database");
+  const org = await prisma.organisation.findUnique({
+    where: { id: organisationId },
+    select: { settings: true },
+  });
+  const settings = (org?.settings as { systems?: unknown } | null) ?? {};
+  return parseOrgOnboardingSystems(settings.systems);
+}
+
+export async function saveOrgOnboardingSystems(
+  organisationId: string,
+  input: { selectedIds?: unknown; notes?: string },
+): Promise<OrgOnboardingSystems> {
+  const selectedIds = normalizeOnboardingSystemIds(input.selectedIds);
+  const notes = input.notes?.trim() || undefined;
+  const updatedAt = new Date().toISOString();
+  const next: OrgOnboardingSystems = { selectedIds, notes, updatedAt };
+
+  if (!process.env.DATABASE_URL) {
+    return next;
+  }
+
+  const { prisma } = await import("@dg/database");
+  type InputJsonValue = import("@dg/database").Prisma.InputJsonValue;
+  const org = await prisma.organisation.findUnique({
+    where: { id: organisationId },
+    select: { settings: true },
+  });
+  const prev = (org?.settings as Record<string, unknown> | null) ?? {};
+  await prisma.organisation.update({
+    where: { id: organisationId },
+    data: {
+      settings: {
+        ...prev,
+        systems: next,
+      } as InputJsonValue,
+    },
+  });
+
+  const selectedConnectors = GEN2_SYSTEM_OPTIONS.filter(
+    (opt) => opt.connectorId && selectedIds.includes(opt.id),
+  );
+  if (selectedConnectors.length) {
+    const { getOrgConnectorSettings, saveOrgConnectorSettings } = await import(
+      "../connectors/framework/store"
+    );
+    for (const opt of selectedConnectors) {
+      const connectorId = opt.connectorId!;
+      const existing = (await getOrgConnectorSettings(organisationId, connectorId)) ?? {};
+      await saveOrgConnectorSettings(organisationId, connectorId, {
+        ...existing,
+        onboardingSelected: true,
+        onboardingSelectedAt: updatedAt,
+      });
+    }
+  }
+
+  return next;
+}
